# Copy to .env; replace both tokens before starting.
JOB_API_TOKEN=replace-with-a-long-random-api-token
JOB_WORKER_TOKEN=replace-with-a-different-long-random-worker-token
# Local Compose is loopback-only and intentionally has no browser authentication.
JOB_AUTH_MODE=none
JOB_BASE_PATH=/jobs
# Published images use main or sha-<commit>; use local for local builds.
JOB_IMAGE_TAG=main
