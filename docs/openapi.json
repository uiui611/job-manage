  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "DefinitionSpec": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string"
          },
          "driver": {
            "enum": [
              "node",
              "python"
            ]
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          },
          "input_schema": {
            "description": "JSON Schema; external references are disabled"
          },
          "required_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 604800,
            "default": 3600
          }
        },
        "required": [
          "name",
          "driver",
          "script"
        ]
      },
      "Definition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "spec": {
            "$ref": "#/components/schemas/DefinitionSpec"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InputFile": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique ASCII filename; Windows reserved filenames and trailing dot prohibited"
          },
          "artifact_id": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "artifact_id"
        ]
      },
      "Submit": {
        "type": "object",
        "properties": {
          "definition_id": {
            "type": "string"
          },
          "input": {},
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputFile"
            }
          }
        },
        "required": [
          "definition_id"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "definition_id": {
            "type": "string"
          },
          "definition_name": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "spec": {
            "$ref": "#/components/schemas/DefinitionSpec"
          },
          "input": {},
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputFile"
            }
          },
          "status": {
            "enum": [
              "queued",
              "assigned",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "waiting_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "description": "Absolute S3 URL or origin-relative signed local URL"
          }
        }
      },
      "Worker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "drivers": {
            "type": "array",
            "items": {
              "enum": [
                "node",
                "python"
              ]
            }
          },
          "status": {
            "enum": [
              "online",
              "busy",
              "offline"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          },
          "active_run_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "api",
              "worker"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked": {
            "type": "boolean"
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "base_path": {
            "type": "string"
          },
          "heartbeat_timeout_seconds": {
            "type": "integer"
          },
          "max_artifact_bytes": {
            "type": "integer"
          },
          "max_total_file_bytes": {
            "type": "integer"
          },
          "max_files": {
            "type": "integer"
          },
          "storage": {
            "enum": [
              "local",
              "s3"
            ]
          },
          "auto_retry": {
            "const": false
          },
          "scheduler_paused": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
