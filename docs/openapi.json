{
  "openapi": "3.1.0",
  "info": {
    "title": "JOB Platform API",
    "version": "0.1.0",
    "description": "Single-user asynchronous JOB execution. Bearer API tokens work directly through the Kubernetes Service. Worker tokens are accepted only by the WebSocket endpoint. UI uses a trusted proxy token and X-Job-Request: 1 on mutations. Signed transfer URLs require no API/worker token. Connection loss fails the run; no automatic retry."
  },
  "servers": [
    {
      "url": ".",
      "description": "API base relative to this document; hosted below the configured base path"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
