# syntax=docker/dockerfile:1
FROM oven/bun:1.4.2 AS web-build
WORKDIR /src/web
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile
COPY web/ ./
RUN bun run build

FROM rust:bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY docs/ ./docs/
ENV CARGO_BUILD_JOBS=4 CARGO_TARGET_DIR=/build-target
RUN --mount=type=cache,id=job-platform-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=job-platform-target,target=/build-target \
    cargo build --release --locked --workspace \
    && mkdir -p /out \
    && cp /build-target/release/job-server /build-target/release/job-worker /out/

FROM debian:bookworm-slim
LABEL org.opencontainers.image.source="https://github.com/uiui611/job-manage" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Job Manage server"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 job && useradd --uid 10001 --gid job --no-create-home job \
    && mkdir -p /app/web /data && chown -R job:job /app /data
COPY --from=rust-build /out/job-server /usr/local/bin/job-server
COPY --from=web-build /src/web/dist /app/web
COPY LICENSE /usr/share/doc/job-manage/LICENSE
ENV JOB_BIND=0.0.0.0:8080 JOB_WEB_DIR=/app/web JOB_STORAGE_DIR=/data
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/job-server"]
